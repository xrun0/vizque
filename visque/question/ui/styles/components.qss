/* Eğer seçenekleri bir "satır" QWidget içinde sunarsan: */
QWidget#OptionRow {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  padding: 10px;
}
QWidget#OptionRow:hover {
  background: #EEF2FF; /* hafif mavi */
}
QWidget#OptionRow[checked="true"] {
  border-color: #3B82F6;
  background: #EFF6FF;
}
