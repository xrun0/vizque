/* === sayfa arka plan + genel === */
QWidget {
  background: #F7F7F7;
  color: #000;
  font-size: 22px;
}
QWidget#startPage {
    background: #FFFFFF;
}

/* === başlıklar === */
QLabel#title {
    font-size: 28px;
    font-weight: 600;
    color: #111827; /* slate-900 */
    margin-top: 8px;
}

QLabel#subtitle {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
}

/* === kart alanı === */
QWidget#card {
    padding: 0;
}

/* resim çerçevesi (turkuaz kenarlık) */
QFrame#imageFrame {
    border: 6px solid #1FB6C9;   /* teal */
    border-radius: 6px;
    background: #FFFFFF;
}

/* kart başlığı (kategori adı) */
QLabel#cardTitle {
    font-size: 18px;
    color: #111827;
}

/* numara satırı: "1 Numaralı Kare" */
QLabel#cardNumber {
    font-size: 20px;
    font-weight: 700;
    color: #EF4444;   /* kırmızı */
}
QLabel#cardNumberText {
    font-size: 18px;
    color: #111827;
}

/* logolar satırı */
QWidget#logosWrap {
    margin-top: 18px;
    margin-bottom: 6px;
}
QLabel#logo {
    background: transparent;
}

/* küçük etkileşim (opsiyonel) */
QWidget#card:hover QFrame#imageFrame {
    border-color: #109DB0;
}
QWidget#card:hover {
    /* imleç */
    /* cursor: pointing_hand; */
}


/*BURADAN SONRA QUESTİONPAGE */
/* Question Page genel */
#questionPage {
    background: #ffffff;
    font-family: "Inter", "Helvetica", "Arial";
}

/* Topbar */
#timerLabel { font-size: 22px; font-weight: 700; }
#progressLabel { font-size: 18px; font-weight: 700; }
#qmarkLabel { font-size: 24px; color: #f59e0b; }

/* Soru kutusu */
#questionBox {
    background: #f4efed;           /* açık bej hissi */
    border-radius: 14px;
    border: 1px solid #ece6e3;
    padding: 12px;
}
#questionLabel {
    font-size: 20px;
    font-weight: 600;
    color: #222;
}

/* Kırmızı uyarı */
#instruction {
    color: #ef4444;
    font-size: 16px;
    font-weight: 600;
}

/* Şık kartları */
#optionCard {
    background: #f4efed;
    border: 1px solid #e7e2df;
    border-radius: 16px;
    min-width: 240px;
    min-height: 110px;
    transition: all 120ms ease;
}
#optionCard:hover {
    border-color: #d6d0cd;
    transform: translateY(-1px);
}
#optionText {
    color: #1f2937;
    font-size: 18px;
    font-weight: 600;
}
#optionLetter {
    margin-top: 8px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #111827;
}

/* Şık durum renkleri (setAnswerState ile) */
#optionCard[state="selected"] { border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(59,130,246,0.17); }
#optionCard[state="correct"]  { border-color: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.18); }
#optionCard[state="wrong"]    { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.18); }

/* Alt logolar */
#bottomLogo { opacity: 0.95; }
#bottomLogo:hover { opacity: 1.0; }

/*BURADAN SONRA RESULTPAGE */
#resultPage {
    background: #f7f4ef;
}

#resultCard {
    background: #f6f2ec;
    border-radius: 24px;
    border: 1px solid #eee7dd;
    padding: 12px;
}

#resultCardTitle {
    font-size: 32px;
    font-weight: 600;
    color: #555555;
}

#resultCardValue {
    font-size: 40px;
    font-weight: 700;
    color: #444444;
}

#resultMessageCard {
    background: #f6f2ec;
    border-radius: 24px;
    border: 1px solid #eee7dd;
}

#resultMessageLabel {
    font-size: 32px;
    font-weight: 600;
    color: #2eaf5d; /* yeşil */
}

#resultLogo {
    background: transparent;
}
