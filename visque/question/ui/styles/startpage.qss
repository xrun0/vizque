/* === sayfa arka plan + genel === */
QWidget {
  background: #FFFFFF;
  color: #000;
  font-size: 22px;
}
QWidget#startPage {
    background: #FFFFFF;
}

/* === başlıklar === */
QLabel#title {
    font-size: 80px;
    font-weight: 600;
    color: #111827; /* slate-900 */
    margin-top: 8px;
}

QLabel#subtitle {
    font-size: 62px;
    font-weight: 600;
    color: #111827;
}

/* === kart alanı === */
QWidget#card {
    padding: 0;
}

/* resim çerçevesi (turkuaz kenarlık) */
QFrame#imageFrame {
    border: 6px solid #1FB6C9;   /* teal */
    border-radius: 6px;
    background: #FFFFFF;
}

/* kart başlığı (kategori adı) */
QLabel#cardTitle {
    font-size: 18px;
    color: #111827;
}

/* numara satırı: "1 Numaralı Kare" */
QLabel#cardNumber {
    font-size: 20px;
    font-weight: 700;
    color: #EF4444;   /* kırmızı */
}
QLabel#cardNumberText {
    font-size: 18px;
    color: #111827;
}

/* logolar satırı */
QWidget#logosWrap {
    margin-top: 18px;
    margin-bottom: 6px;
    width:500px;
}
QLabel#logo {
    width:500px;
    height:200px;
}

#anaLogo {
    min-width: 400px;
    max-width: 400px;
    min-height: 400px;
    max-height: 400px;
}

/* küçük etkileşim (opsiyonel) */
QWidget#card:hover QFrame#imageFrame {
    border-color: #109DB0;
}
QWidget#card:hover {
    /* imleç */
    /* cursor: pointing_hand; */
}


/*BURADAN SONRA QUESTİONPAGE */
/* Question Page genel */
#questionPage {
    background: #ffffff;
    font-family: "Inter", "Helvetica", "Arial";
}

/* Topbar */
#timerLabel { font-size: 68px; font-weight: 700; }
#progressLabel { font-size: 68px; font-weight: 700; }
#timerIcon { font-size: 68px; font-weight: 700; }
#qmarkLabel { font-size: 68px; color: #f59e0b; }

/* Soru kutusu */
#questionBox {
    margin-bottom: 70%;
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 2px solid #F5DCD2;
}
#questionLabel {
    font-size: 52px;
    font-weight: 600;
    color: #222;
}

/* Kırmızı uyarı */
#instruction {
    margin-bottom: 70%;
    color: #ef4444;
    font-size: 38px;
    font-weight: 600;
}

/* Şık kartları */
#optionCard {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 2px solid #F5DCD2;
    min-width: 240px;
    min-height: 110px;
}


#optionText {
    color: #1f2937;
    font-size: 42px;
    font-weight: 600;
}
#optionLetter {
    margin-top: 8px;
    font-size: 58px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #111827;
}

/* Şık durum renkleri (setAnswerState ile) */
#optionCard[state="selected"] {border: 6px solid; border-color: #60a5fa; box-shadow: 0 0 0 8px rgba(59,130,246,0.17); }
#optionCard[state="correct"]  {border: 6px solid; border-color: #22c55e; box-shadow: 0 0 0 8px rgba(34,197,94,0.18); }
#optionCard[state="wrong"]    {border: 6px solid; border-color: #ef4444; box-shadow: 0 0 0 8px rgba(239,68,68,0.18); }

/* Alt logolar */
#bottomLogo { opacity: 0.95;width:500px; }
#bottomLogo:hover { opacity: 1.0; }

/*BURADAN SONRA RESULTPAGE */
#resultPage {
    background: #FFFFFF;
}

#resultCard {
    background: #FFFFFF;
    border-radius: 24px;
    border: 2px solid #F5DCD2;
    padding: 4px;
}

#resultCardTitle {
    font-size: 48px;
    font-weight: 600;
    color: #555555;
}

#resultCardValue {
    font-size: 64px;
    font-weight: 700;
    color: #444444;
}

#resultMessageCard {
    background: #FFFFFF;
    border-radius: 62px;
    border: 2px solid #F5DCD2;
}

#resultMessageLabel {
    font-size: 64px;
    font-weight: 600;
    color: #2eaf5d; /* yeşil */
}

#resultLogo {
    background: transparent;
}
